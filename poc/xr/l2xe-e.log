redundancy all-active
XE1(config-evpn-es)#
exit
XE1(config)#
interface Port-channel1
XE1(config-if)#
no ip address
XE1(config-if)#
lacp device-id 0000.0000.0001
XE1(config-if)#
evpn ethernet-segment 1
XE1(config-if)#
service instance 200 ethernet
XE1(config-if-srv)#
encapsulation dot1q 200
XE1(config-if-srv)#
rewrite ingress tag pop 1 symmetric
XE1(config-if-srv)#
exit
XE1(config-if)#
exit
XE1(config)#
interface GigabitEthernet3
XE1(config-if)#
no ip address
XE1(config-if)#
channel-group 1 mode active
XE1(config-if)#
exit
XE1(config)#
bridge-domain 200
XE1(config-bdomain)#
member Port-channel1 service-instance 200
XE1(config-bdomain-efp)#
end
