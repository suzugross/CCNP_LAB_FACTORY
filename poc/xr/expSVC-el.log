
######## 21:50:34 el-1: EVPN の E-LAN(VLAN 200・EVI 200・vlan-based)= XE1〜3。入れ物= EVI+ブリッジ ドメイン
configure terminal
Enter configuration commands, one per line.  End with CNTL/Z.
XE1(config)#
l2vpn evpn
XE1(config-evpn)#
replication-type ingress
XE1(config-evpn)#
router-id Loopback0
XE1(config-evpn)#
exit
XE1(config)#
l2vpn evpn instance 200 vlan-based
XE1(config-evpn-evi)#
exit
XE1(config)#
interface GigabitEthernet2
XE1(config-if)#
service instance 200 ethernet
XE1(config-if-srv)#
encapsulation dot1q 200
XE1(config-if-srv)#
rewrite ingress tag pop 1 symmetric
XE1(config-if-srv)#
exit
XE1(config-if)#
exit
XE1(config)#
bridge-domain 200
XE1(config-bdomain)#
member GigabitEthernet2 service-instance 200
XE1(config-bdomain-efp)#
member evpn-instance 200
XE1(config-bdomain)#
end
