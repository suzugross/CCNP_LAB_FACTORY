######## igmp-ex2: PE3 の join-group を外し、PE2(ACCESS-2 の DR)に version 2 と join-group 239.9.9.9
configure
RP/0/RP0/CPU0:PE3(config)#
router igmp
RP/0/RP0/CPU0:PE3(config-igmp)#
interface GigabitEthernet0/0/0/1
RP/0/RP0/CPU0:PE3(config-igmp-default-if)#
no join-group 239.9.9.9
RP/0/RP0/CPU0:PE3(config-igmp-default-if)#
no version
RP/0/RP0/CPU0:PE3(config-igmp-default-if)#
commit
RP/0/RP0/CPU0:PE3(config-igmp-default-if)#
end
RP/0/RP0/CPU0:PE3#
configure terminal
Enter configuration commands, one per line.  End with CNTL/Z.
PE4(config)#
interface Ethernet0/1
PE4(config-if)#
no ip igmp join-group 239.9.9.9
PE4(config-if)#
end
PE4#
configure
RP/0/RP0/CPU0:PE2(config)#
router igmp
RP/0/RP0/CPU0:PE2(config-igmp)#
 interface GigabitEthernet0/0/0/3
RP/0/RP0/CPU0:PE2(config-igmp-default-if)#
  version 2
RP/0/RP0/CPU0:PE2(config-igmp-default-if)#
  join-group 239.9.9.9
RP/0/RP0/CPU0:PE2(config-igmp-default-if)#
 !
RP/0/RP0/CPU0:PE2(config-igmp-default-if)#
!
RP/0/RP0/CPU0:PE2(config-igmp-default-if)#
commit
RP/0/RP0/CPU0:PE2(config-igmp-default-if)#
show configuration failed
% No such configuration item(s)

RP/0/RP0/CPU0:PE2(config-igmp-default-if)#
end
