######## setonly: set だけ(pass なし)のポリシーを ISP-A の入力に
configure
route-policy T-SET
set local-preference 150
end-policy
router bgp 65000
neighbor 10.0.11.2
address-family ipv4 unicast
route-policy T-SET in
commit
end
RP/0/RP0/CPU0:XR01#
show bgp ipv4 unicast neighbors 10.0.11.2 routes
RP/0/RP0/CPU0:XR01#
show bgp neighbor 10.0.11.2 | include "denied|By policy"
  Exact no. of prefixes denied: 0
  Cumulative no. of prefixes denied: 0
RP/0/RP0/CPU0:XR01#
######## ifset: 条件つき set だけ(合わない経路は?)
configure
route-policy T-SET
% WARNING: Policy object route-policy T-SET exists! Reconfiguring it via CLI will replace current definition. Use abort to cancel.
if destination in (11.0.0.0/8) then
set local-preference 150
endif
end-policy
commit
end
RP/0/RP0/CPU0:XR01#
show bgp ipv4 unicast neighbors 10.0.11.2 routes
RP/0/RP0/CPU0:XR01#
