CE1(config-if)#
interface Loopback10
CE1(config-if)#
ip address 10.10.0.1 255.255.255.255
CE1(config-if)#
ip access-list extended TO-VOICE
CE1(config-ext-nacl)#
permit ip any host 10.46.0.2
CE1(config-ext-nacl)#
ip access-list extended TO-BULK
CE1(config-ext-nacl)#
permit ip any host 10.10.0.2
CE1(config-ext-nacl)#
class-map match-any TO-VOICE
CE1(config-cmap)#
match access-group name TO-VOICE
CE1(config-cmap)#
class-map match-any TO-BULK
CE1(config-cmap)#
match access-group name TO-BULK
CE1(config-cmap)#
policy-map MARK
CE1(config-pmap)#
class TO-VOICE
CE1(config-pmap-c)#
set dscp ef
CE1(config-pmap-c)#
class TO-BULK
CE1(config-pmap-c)#
set dscp af11
CE1(config-pmap-c)#
exit
CE1(config-pmap)#
exit
