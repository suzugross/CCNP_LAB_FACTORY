######## per-if enable の構文(multicast-routing の address-family ipv4 の下の interface X enable)
configure
RP/0/RP0/CPU0:P1(config)#
multicast-routing
RP/0/RP0/CPU0:P1(config-mcast)#
address-family ipv4
RP/0/RP0/CPU0:P1(config-mcast-default-ipv4)#
interface GigabitEthernet0/0/0/2
RP/0/RP0/CPU0:P1(config-mcast-default-ipv4-if)#
enable
RP/0/RP0/CPU0:P1(config-mcast-default-ipv4-if)#
commit
RP/0/RP0/CPU0:P1(config-mcast-default-ipv4-if)#
show configuration failed
% No such configuration item(s)

RP/0/RP0/CPU0:P1(config-mcast-default-ipv4-if)#
show running-config multicast-routing
multicast-routing
 address-family ipv4
  interface GigabitEthernet0/0/0/2
   enable
  !
  interface all enable
 !
 address-family ipv6
  interface all enable
 !
!

RP/0/RP0/CPU0:P1(config-mcast-default-ipv4-if)#
abort
RP/0/RP0/CPU0:P1#
