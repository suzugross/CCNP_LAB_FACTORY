######## comm: 顧客の入力に as-path・community の判定と削除
configure
as-path-set CUST-AS
ios-regex '^65201(_65201)*$'
end-set
route-policy T-CUST
if as-path in CUST-AS then
pass
endif
end-policy
route-policy T-PASS
pass
end-policy
router bgp 65000
neighbor 10.0.13.2
address-family ipv4 unicast
route-policy T-CUST in
route-policy T-PASS out
commit
end
