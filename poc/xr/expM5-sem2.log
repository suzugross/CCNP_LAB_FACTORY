RP/0/RP0/CPU0:XR01#
configure
community-set SIG
65000:*
end-set
route-policy T-OUT
if community matches-any (65000:1002) then
drop
endif
delete community in SIG
pass
end-policy
router bgp 65000
neighbor 10.0.12.2
address-family ipv4 unicast
route-policy T-OUT out
send-community-ebgp
root
router bgp 65000
neighbor 10.0.11.2
address-family ipv4 unicast
route-policy T-OUT out
send-community-ebgp
commit
