[edit]
admin@jun02# 
## [JUN02] show policy-options policy-statement TO-ISP
show policy-options policy-statement TO-ISP 
term LAN {
    from {
        protocol ospf;
        route-filter 172.16.0.0/16 orlonger;
    }
    then accept;
}
term REST {
    then reject;
}
term AGG {
    from {
        protocol aggregate;
        route-filter 172.16.0.0/16 exact;
    }
    then {
        as-path-prepend "65000 65000";
        accept;
    }
}

