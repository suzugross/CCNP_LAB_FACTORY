admin@jun02> show configuration firewall | no-more 
family inet {
    filter FROM-ISP {
        term BGP {
            from {
                source-address {
                    10.0.23.2/32;
                }
                protocol tcp;
                port bgp;
            }
            then accept;
        }
        term ICMP {
            from {
                protocol icmp;
            }
            then accept;
        }
        term WEB {
            from {
                destination-address {
                    172.16.20.0/24;
                }
                protocol tcp;
                destination-port [ http https ];
            }
            then accept;
        }
        term SSH {
            from {
                source-address {
                    203.0.113.0/24;
                }
                destination-address {
                    172.16.20.0/24;
                }
                protocol tcp;
                destination-port ssh;
            }
            then accept;
        }
        term RETURN {
            from {
                protocol tcp;
                tcp-established;
            }
            then accept;
        }
        term DENY {
            then {
                count ISP-DENY;
                log;
                syslog;
                discard;
            }
        }
    }
    filter NO-BOGONS {
        term BOGON {
            from {
                source-prefix-list {
                    BOGONS;
                    ISP-LINK except;
                }
            }
            then {
                count BOGON;
                discard;
            }
        }
    }
    filter PROTECT-RE {
        term BGP {
            from {
                source-prefix-list {
                    BGP-PEERS;
                }
                protocol tcp;
                port bgp;
            }
            then accept;
        }
        term OSPF {
            from {
                protocol ospf;
            }
            then accept;
        }
        term ICMP {
            from {
                protocol icmp;
            }
            then accept;
        }
        term SSH {
            from {
                source-address {
                    172.16.0.0/16;
                }
                protocol tcp;
                destination-port ssh;
            }
            then accept;
        }
        term RETURN {
            from {
                protocol tcp;
                tcp-established;
            }
            then accept;
        }
        term DENY {
            then {
                count RE-DENY;
                discard;
            }
        }
    }
}

admin@jun02> show configuration interfaces et-0/0/1 | no-more 
description "to ISP (FRR1)";
unit 0 {
    family inet {
        filter {
            input-list [ NO-BOGONS FROM-ISP ];
        }
        address 10.0.23.1/30;
    }
}

admin@jun02> show configuration interfaces lo0 | no-more 
