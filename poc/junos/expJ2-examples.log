[edit interfaces et-0/0/1 unit 0 family inet]
+       filter {
+           output TO-SERVERS;
+       }
[edit]
+  firewall {
+      family inet {
+          filter TO-SERVERS {
+              term ICMP {
+                  from {
+                      protocol icmp;
+                  }
+                  then accept;
+              }
+              term WEB {
+                  from {
+                      destination-address {
+                          172.16.20.0/24;
+                      }
+                      protocol tcp;
+                      destination-port http;
+                  }
+                  then {
+                      count WEB-IN;
+                      accept;
+                  }
+              }
+              term LAST {
+                  then {
+                      count TO-SERVERS-DROP;
+                      discard;
+                  }
+              }
+          }
+      }
+  }

