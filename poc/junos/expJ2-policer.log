	-i SECS		Interval
	-I IFACE/IP	Source interface or IP address
frr1:/# 
## [FRR1:sh] ip addr add 10.200.0.1/32 dev lo 2>/dev/null; ip -4 addr show lo | grep inet
ip addr add 10.200.0.1/32 dev lo 2>/dev/null; ip -4 addr show lo | grep inet
    inet 127.0.0.1/8 scope host lo
    inet 203.0.113.1/32 brd 203.0.113.1 scope global lo
    inet 10.200.0.1/32 scope global lo
