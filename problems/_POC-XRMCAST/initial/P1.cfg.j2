!! _POC-XRMCAST P1(XRd 26.1.1)= P(RP の候補)。ユニキャストの土台(IS-IS の IPv4/IPv6)まで。マルチキャストは PoC の段で足す。
interface Loopback0
 ipv4 address 10.255.0.11 255.255.255.255
 ipv6 address 2001:db8:255::11/128
!
interface {{ links[3] }}
 description to PE1
 ipv4 address 10.0.1.11 255.255.255.0
 ipv6 address 2001:db8:1::11/64
 no shutdown
!
interface {{ links[4] }}
 description to PE2
 ipv4 address 10.0.2.11 255.255.255.0
 ipv6 address 2001:db8:2::11/64
 no shutdown
!
interface {{ links[5] }}
 description to P2
 ipv4 address 10.0.3.11 255.255.255.0
 ipv6 address 2001:db8:3::11/64
 no shutdown
!
router isis CORE
 is-type level-2-only
 net 49.0001.0100.0000.0011.00
 log adjacency changes
 address-family ipv4 unicast
  metric-style wide
 !
 address-family ipv6 unicast
  metric-style wide
 !
 interface Loopback0
  passive
  address-family ipv4 unicast
  !
  address-family ipv6 unicast
  !
 !
 interface {{ links[3] }}
  point-to-point
  address-family ipv4 unicast
  !
  address-family ipv6 unicast
  !
 !
 interface {{ links[4] }}
  point-to-point
  address-family ipv4 unicast
  !
  address-family ipv6 unicast
  !
 !
 interface {{ links[5] }}
  point-to-point
  address-family ipv4 unicast
  !
  address-family ipv6 unicast
  !
 !
!
