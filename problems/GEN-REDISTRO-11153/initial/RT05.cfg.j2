! RT05 初期構成 (相互再配送 RIP⇄OSPF TS・故障注入済)
interface Loopback0
 ip address 37.37.37.37 255.255.255.255
!
interface {{ links[0] }}
 ip address 172.16.167.2 255.255.255.252
 no shutdown
!
interface {{ links[1] }}
 ip address 172.16.76.2 255.255.255.252
 no shutdown
!
router ospf 1
 router-id 37.37.37.37
 network 37.37.37.37 0.0.0.0 area 0
 network 172.16.167.0 0.0.0.3 area 0
 network 172.16.76.0 0.0.0.3 area 0
!
