! RT04 (role=mhop, AS=65200) 初期構成
interface Loopback0
 ip address 10.0.42.42 255.255.255.255
!
interface Loopback1
 ip address 198.51.100.1 255.255.255.0
!
interface {{ links[0] }}
 ip address 10.164.164.2 255.255.255.252
 no shutdown
!
ip route 10.0.75.75 255.255.255.255 10.164.164.1
!
router bgp 65200
 bgp router-id 10.0.42.42
 bgp log-neighbor-changes
