! RT01 (role=leaf, AS=65001) 初期構成
interface Loopback0
 ip address 10.0.90.90 255.255.255.255
 ip ospf 1 area 0
!
interface Loopback1
 ip address 192.0.2.1 255.255.255.0
!
interface {{ links[0] }}
 ip address 10.186.186.2 255.255.255.252
 ip ospf 1 area 0
 no shutdown
!
router ospf 1
 router-id 10.0.90.90
!
router bgp 65001
 bgp router-id 10.0.90.90
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
 neighbor 10.0.91.91 remote-as 65001
 neighbor 10.0.91.91 update-source Loopback0
 neighbor 10.0.91.91 password CCNPBGP
 address-family ipv4 unicast
  neighbor 10.0.91.91 activate
  neighbor 10.0.91.91 send-community
  network 192.0.2.0 mask 255.255.255.0
 exit-address-family
!
