! RT05 (role=hub, AS=65001) 初期構成
interface Loopback0
 ip address 10.0.91.91 255.255.255.255
 ip ospf 1 area 0
!
interface {{ links[0] }}
 ip address 10.173.173.1 255.255.255.252
 ip ospf 1 area 0
 no shutdown
!
interface {{ links[1] }}
 ip address 10.123.123.1 255.255.255.252
 ip ospf 1 area 0
 no shutdown
!
interface {{ links[2] }}
 ip address 10.186.186.1 255.255.255.252
 ip ospf 1 area 0
 no shutdown
!
router ospf 1
 router-id 10.0.91.91
!
router bgp 65001
 bgp router-id 10.0.91.91
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
 neighbor 10.0.52.52 remote-as 65001
 neighbor 10.0.52.52 update-source Loopback0
 neighbor 10.0.75.75 remote-as 65001
 neighbor 10.0.75.75 update-source Loopback0
 neighbor 10.0.90.90 remote-as 65001
 neighbor 10.0.90.90 update-source Loopback0
 address-family ipv4 unicast
  neighbor 10.0.52.52 activate
  neighbor 10.0.52.52 send-community
  neighbor 10.0.52.52 route-reflector-client
  neighbor 10.0.75.75 activate
  neighbor 10.0.75.75 send-community
  neighbor 10.0.75.75 route-reflector-client
  neighbor 10.0.90.90 activate
  neighbor 10.0.90.90 send-community
  neighbor 10.0.90.90 route-reflector-client
 exit-address-family
!
