! RT02
interface Loopback0
 ip address 90.90.90.90 255.255.255.255
!
interface Loopback1
 ip address 172.16.37.1 255.255.255.0
!
interface {{ links[1] }}
 ip address 10.152.206.1 255.255.255.252
 no shutdown
!
interface {{ links[0] }}
 ip address 10.42.221.2 255.255.255.252
 no shutdown
!
router bgp 65202
 bgp router-id 90.90.90.90
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
 bgp bestpath compare-routerid
 neighbor 10.152.206.2 remote-as 65454
 neighbor 10.42.221.1 remote-as 65405
 address-family ipv4 unicast
  network 172.16.37.0 mask 255.255.255.0
  neighbor 10.152.206.2 activate
  neighbor 10.42.221.1 activate
  neighbor 10.152.206.2 route-map RM-LP-IN in
  neighbor 10.42.221.1 route-map RM-PREPEND-OUT out
  neighbor 10.42.221.1 route-map RM-OLD-POLICY in
 exit-address-family
!
ip prefix-list PL-DIAG permit 172.16.210.0/24
route-map RM-LP-IN permit 10
 match ip address prefix-list PL-DIAG
 set local-preference 200
route-map RM-LP-IN permit 20
!
ip prefix-list PL-SELF permit 172.16.37.0/24
route-map RM-PREPEND-OUT permit 10
 match ip address prefix-list PL-SELF
 set as-path prepend 65202 65202
route-map RM-PREPEND-OUT permit 20
!
route-map RM-OLD-POLICY permit 10
 match ip address prefix-list PL-DIAG
 set local-preference 300
route-map RM-OLD-POLICY permit 20
!
