! RT03
interface Loopback0
 ip address 86.86.86.86 255.255.255.255
!
interface Loopback1
 ip address 172.16.9.1 255.255.255.0
!
interface {{ links[1] }}
 ip address 10.33.245.1 255.255.255.252
 no shutdown
!
interface {{ links[0] }}
 ip address 10.152.206.2 255.255.255.252
 no shutdown
!
router bgp 65454
 bgp router-id 86.86.86.86
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
 bgp bestpath compare-routerid
 neighbor 10.33.245.2 remote-as 64857
 neighbor 10.152.206.1 remote-as 65202
 address-family ipv4 unicast
  network 172.16.9.0 mask 255.255.255.0
  neighbor 10.33.245.2 activate
  neighbor 10.152.206.1 activate
 exit-address-family
!
ip prefix-list PL-ARCHIVE seq 5 permit 192.0.2.134/32
!
