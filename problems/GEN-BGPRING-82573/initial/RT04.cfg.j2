! RT04
interface Loopback0
 ip address 85.85.85.85 255.255.255.255
!
interface Loopback1
 ip address 172.16.210.1 255.255.255.0
!
interface {{ links[1] }}
 ip address 10.212.65.1 255.255.255.252
 no shutdown
!
interface {{ links[0] }}
 ip address 10.33.245.2 255.255.255.252
 no shutdown
!
router bgp 64857
 bgp router-id 85.85.85.85
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
 bgp bestpath compare-routerid
 neighbor 10.212.65.2 remote-as 65405
 neighbor 10.33.245.1 remote-as 65454
 address-family ipv4 unicast
  network 172.16.210.0 mask 255.255.255.0
  neighbor 10.212.65.2 activate
  neighbor 10.33.245.1 activate
  neighbor 10.33.245.1 allowas-in
 exit-address-family
!
