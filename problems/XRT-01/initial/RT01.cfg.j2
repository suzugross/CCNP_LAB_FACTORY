! XRT-01 RT01(据付・変更しない)
! LINK3 の OSPF 鍵を平文で見せないため(M1-7 は「変更前の値は記録が無い」前提)
service password-encryption
ipv6 unicast-routing
interface Loopback0
 ip address 2.2.2.2 255.255.255.255
 ip ospf 1 area 0
!
interface Loopback8
 description INTERNET (not in OSPF)
 ip address 8.8.8.8 255.255.255.255
!
interface Loopback100
 ip address 198.51.100.1 255.255.255.0
!
interface {{ links[0] }}
 description LINK1 to XR01
 ip address 10.0.12.2 255.255.255.0
 ipv6 address 2001:DB8:12::2/64
 ip ospf 1 area 0
 ip ospf network point-to-point
 no shutdown
!
interface {{ links[1] }}
 description LINK2 to XR01
 ip address 10.0.21.2 255.255.255.0
 ip ospf 1 area 0
 ip ospf network point-to-point
 no shutdown
!
interface {{ links[2] }}
 description LINK3 to XR01
 ip address 10.0.31.2 255.255.255.0
 ip ospf 1 area 0
 ip ospf network point-to-point
 ip ospf authentication message-digest
 ip ospf message-digest-key 1 md5 L1nk3Key
 ip ospf hello-interval 5
 ip ospf dead-interval 20
 no shutdown
!
router ospf 1
 router-id 2.2.2.2
!
router bgp 65002
 bgp router-id 2.2.2.2
 bgp log-neighbor-changes
 network 198.51.100.0 mask 255.255.255.0
 neighbor 10.0.12.1 remote-as 65001
!
