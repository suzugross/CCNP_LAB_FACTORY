! ============================================================
! RT01 — 基線(IP+基本ルーティング)は構築済み。
! リスト・再配送は未投入(作問仕様)。
! ============================================================
interface Loopback0
 ip address 1.1.1.1 255.255.255.255
interface Ethernet0/0
 description === to RT02 (EIGRP) ===
 ip address 10.1.12.1 255.255.255.252
 no shutdown
interface Ethernet0/1
 description === to RT03 (EIGRP) ===
 ip address 10.1.13.1 255.255.255.252
 no shutdown
interface Ethernet0/2
 description === to RT05 (OSPF) ===
 ip address 10.1.15.1 255.255.255.252
 no shutdown
!
router eigrp 25332
 eigrp router-id 1.1.1.1
 network 10.1.12.0 0.0.0.3
 network 10.1.13.0 0.0.0.3
 no auto-summary
!
router ospf 79
 router-id 1.1.1.1
 network 10.1.15.0 0.0.0.3 area 0
