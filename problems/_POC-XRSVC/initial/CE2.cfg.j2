! _POC-XRSVC CE2(IOL 17.15)= お客さまの CE(拠点 2)。サービスごとのサブインタフェース。L2 のサービスは 192.168.<VLAN>.0/24(ホスト部 2)。
interface {{ links[0] }}
 description to PE
 no ip address
 no shutdown
!
interface {{ links[0] }}.100
 description L3VPN (VRF A)
 encapsulation dot1Q 100
 ip address 172.16.2.1 255.255.255.0
!
interface {{ links[0] }}.140
 encapsulation dot1Q 140
 ip address 192.168.140.2 255.255.255.0
!
interface {{ links[0] }}.200
 encapsulation dot1Q 200
 ip address 192.168.200.2 255.255.255.0
!
interface {{ links[0] }}.210
 encapsulation dot1Q 210
 ip address 192.168.210.2 255.255.255.0
!
interface Loopback100
 description site 2 LAN (L3VPN)
 ip address 10.100.2.1 255.255.255.0
!
router bgp 65002
 bgp router-id 10.100.2.1
 bgp log-neighbor-changes
 neighbor 172.16.2.254 remote-as 65000
 !
 address-family ipv4
  network 10.100.2.0 mask 255.255.255.0
  neighbor 172.16.2.254 activate
 exit-address-family
!
