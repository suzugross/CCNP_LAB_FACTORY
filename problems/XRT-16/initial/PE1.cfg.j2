!! XRT-16 PE1(XRd 26.1.1)= 送信元の側の PE(SRC1= 見出しの送信元)。ユニキャストの土台(IS-IS の IPv4/IPv6)＋前任者の IPv6 の試行。
interface Loopback0
 ipv4 address 10.255.0.1 255.255.255.255
 ipv6 address 2001:db8:255::1/128
!
interface {{ links[3] }}
 description to PE2 (direct)
 ipv4 address 10.0.12.1 255.255.255.0
 ipv6 address 2001:db8:12::1/64
 no shutdown
!
interface {{ links[4] }}
 description to P1
 ipv4 address 10.0.1.1 255.255.255.0
 ipv6 address 2001:db8:1::1/64
 no shutdown
!
interface {{ links[5] }}
 description head-end LAN (SRC1)
 ipv4 address 192.168.1.254 255.255.255.0
 ipv6 address 2001:db8:100:1::254/64
 no shutdown
!
router isis CORE
 is-type level-2-only
 net 49.0001.0100.0000.0001.00
 log adjacency changes
 address-family ipv4 unicast
  metric-style wide
 !
 address-family ipv6 unicast
  metric-style wide
 !
 interface Loopback0
  passive
  address-family ipv4 unicast
  !
  address-family ipv6 unicast
  !
 !
 interface {{ links[3] }}
  point-to-point
  address-family ipv4 unicast
  !
  address-family ipv6 unicast
  !
 !
 interface {{ links[4] }}
  point-to-point
  address-family ipv4 unicast
  !
  address-family ipv6 unicast
  !
 !
 interface {{ links[5] }}
  passive
  address-family ipv4 unicast
  !
  address-family ipv6 unicast
  !
 !
!
!! --- 前任者の作業(M14-6)= IPv6 のマルチキャストの試行。届いていない。IPv4 のマルチキャストは何もない ---
multicast-routing
 address-family ipv6
  interface all enable
 !
!
router pim
 address-family ipv6
  rp-address 2001:db8:255::11
 !
!
