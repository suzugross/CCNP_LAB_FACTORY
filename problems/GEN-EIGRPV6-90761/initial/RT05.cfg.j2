! RT05 (role=e, eigrpv6=named) 初期構成
ipv6 unicast-routing
!
key chain KC6
 key 1
  key-string CCNP6
!
interface Loopback0
 ipv6 address 2001:DB8:52::52/128
!
interface {{ links[0] }}
 ipv6 address 2001:DB8:136::2/64
 no shutdown
!
interface {{ links[1] }}
 ipv6 address 2001:DB8:645::1/64
 no shutdown
!
router eigrp CCNP6
 address-family ipv6 unicast autonomous-system 100
  af-interface {{ links[1] }}
   authentication mode md5
   authentication key-chain KC6
  exit-af-interface
  eigrp router-id 81.81.81.81
 exit-address-family
!
