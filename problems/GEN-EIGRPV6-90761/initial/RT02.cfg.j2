! RT02 (role=s, eigrpv6=classic) 初期構成
ipv6 unicast-routing
!
interface Loopback0
 ipv6 address 2001:DB8:32::32/128
 ipv6 eigrp 100
!
interface {{ links[0] }}
 ipv6 address 2001:DB8:498::1/64
 ipv6 eigrp 100
 no shutdown
!
interface {{ links[1] }}
 ipv6 address 2001:DB8:625::1/64
 ipv6 eigrp 100
 no shutdown
!
ipv6 router eigrp 100
 eigrp router-id 99.99.99.99
!
