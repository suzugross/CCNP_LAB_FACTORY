! RT01 (role=d, eigrpv6=classic) 初期構成
ipv6 unicast-routing
!
interface Loopback0
 ipv6 address 2001:DB8:4::4/128
 ipv6 eigrp 100
!
interface {{ links[0] }}
 ipv6 address 2001:DB8:914::2/64
 ipv6 eigrp 100
 no shutdown
!
interface {{ links[1] }}
 ipv6 address 2001:DB8:368::2/64
 ipv6 eigrp 100
 no shutdown
!
interface {{ links[2] }}
 ipv6 address 2001:DB8:136::1/64
 ipv6 eigrp 100
 no shutdown
!
ipv6 router eigrp 100
 eigrp router-id 13.13.13.13
 eigrp stub connected
!
