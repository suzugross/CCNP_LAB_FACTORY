! RT06 (role=f, eigrpv6=classic) 初期構成
ipv6 unicast-routing
!
key chain KC6
 key 1
  key-string WRONG6
!
interface Loopback0
 ipv6 address 2001:DB8:46::46/128
 ipv6 eigrp 100
!
interface {{ links[0] }}
 ipv6 address 2001:DB8:645::2/64
 ipv6 authentication mode eigrp 100 md5
 ipv6 authentication key-chain eigrp 100 KC6
 ipv6 eigrp 100
 no shutdown
!
interface {{ links[1] }}
 ipv6 address 2001:DB8:421::1/64
 ipv6 eigrp 100
 no shutdown
!
ipv6 router eigrp 100
 eigrp router-id 35.35.35.35
!
