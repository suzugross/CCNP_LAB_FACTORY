! RT04 (role=g, eigrpv6=named) 初期構成
ipv6 unicast-routing
!
interface Loopback0
 ipv6 address 2001:DB8:40::40/128
!
interface {{ links[0] }}
 ipv6 address 2001:DB8:421::2/64
 no shutdown
!
router eigrp CCNP6
 address-family ipv6 unicast autonomous-system 100
  metric weights 0 2 0 1 0 0
  eigrp router-id 24.24.24.24
 exit-address-family
!
