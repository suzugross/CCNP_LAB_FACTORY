#!/bin/bash
# SRVINET: ISP DNS(dnsmasq)・Web(/ip・big.bin)・待受 25/443/445/8080（自動生成 gen_enterprise.py）
export DEBIAN_FRONTEND=noninteractive
log() { echo "[$(date -Is)] $*"; }
echo "{{ ansible_user }} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/90-ccnp; chmod 440 /etc/sudoers.d/90-ccnp
for i in 1 2 3; do apt-get update -qq && apt-get install -y -qq nginx dnsmasq netcat-openbsd dnsutils curl && break; sleep 10; done
cat > /etc/nginx/sites-available/default <<'NG'
server {
  listen 80 default_server;
  root /var/www/html;
  location = /ip { default_type text/plain; return 200 "$remote_addr\n"; }
}
NG
dd if=/dev/urandom of=/var/www/html/big.bin bs=1M count=8 status=none
systemctl restart nginx
cat > /etc/dnsmasq.d/inet.conf <<'DM'
listen-address=192.0.2.10
bind-interfaces
no-resolv
address=/www.inet.example/192.0.2.10
address=/mail.inet.example/192.0.2.10
DM
cat > /etc/systemd/system/ccnp-listen@.service <<'UNIT'
[Unit]
Description=ccnp tcp listener %i
After=network-online.target
[Service]
ExecStart=/bin/nc -lk %i
Restart=always
[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now ccnp-listen@25.service
systemctl enable --now ccnp-listen@443.service
systemctl enable --now ccnp-listen@445.service
systemctl enable --now ccnp-listen@8080.service
cat > /usr/local/bin/ccnp-probe <<'PROBE'
#!/bin/bash
# GEN-ENT 採点用の疎通プローブ（自動生成）。出力= id=結果 の行
ip route flush cache 2>/dev/null; resolvectl flush-caches 2>/dev/null
. /var/tmp/ccnp-peers 2>/dev/null
t_tcp(){ nc -z -w3 "$2" "$3" >/dev/null 2>&1 && echo "$1=OPEN" || echo "$1=CLOSED"; }
t_icmp(){ ping -c2 -W2 -q "$2" >/dev/null 2>&1 && echo "$1=OK" || echo "$1=NG"; }
t_dns(){ r=$(dig +short +time=2 +tries=2 "$2" A 2>/dev/null | grep -E "^[0-9.]+$" | tail -1); echo "$1=${r:-NONE}"; }
t_dnsat(){ r=$(dig +short +time=2 +tries=1 @"$2" "$3" A 2>/dev/null | grep -E "^[0-9.]+$" | tail -1); echo "$1=${r:-NONE}"; }
t_http(){ r=$(curl -s -m5 "$2" 2>/dev/null | head -1); echo "$1=${r:-NONE}"; }
t_big(){ s=$(curl -s -m25 -o /dev/null -w '%{size_download}' "$2" 2>/dev/null); echo "$1=${s:-0}"; }
{
  t_tcp rt01_ssh "198.51.100.60" "22" &
  t_tcp rt01_telnet "198.51.100.60" "23" &
  t_tcp rt01_www "198.51.100.60" "80" &
  t_icmp rt01_ping "198.51.100.60" &
  t_icmp bras_a "198.51.100.1" &
  t_tcp rt02_ssh "203.0.113.57" "22" &
  t_tcp rt02_telnet "203.0.113.57" "23" &
  t_tcp rt02_www "203.0.113.57" "80" &
  t_icmp rt02_ping "203.0.113.57" &
  t_icmp bras_b "203.0.113.1" &
  wait
} | sort
PROBE
chmod 755 /usr/local/bin/ccnp-probe
rm -f /etc/netplan/50-cloud-init.yaml
cat > /etc/netplan/60-ccnp.yaml <<NP
network:
  version: 2
  ethernets:
    ens2:
      addresses: [{{ mgmt_ip }}/{{ mgmt_prefixlen }}]
      routes:
        - to: default
          via: {{ mgmt_gw }}
    ens3:
      addresses: [192.0.2.10/24]
      routes:
        - to: 198.51.100.0/24
          via: 192.0.2.1
        - to: 203.0.113.0/24
          via: 192.0.2.1
NP
chmod 600 /etc/netplan/60-ccnp.yaml
netplan apply
systemctl restart dnsmasq
log "DONE"
