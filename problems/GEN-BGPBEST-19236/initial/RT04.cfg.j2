! RT04 (事業者側・変更禁止)
interface Loopback0
 ip address 4.4.4.4 255.255.255.255
!
interface Loopback100
 ip address 203.0.113.4 255.255.255.0
!
interface {{ links[0] }}
 ip address 10.98.14.4 255.255.255.0
 no shutdown
!
router bgp 65520
 bgp router-id 4.4.4.4
 bgp log-neighbor-changes
 bgp bestpath compare-routerid
 neighbor 10.98.14.1 remote-as 64900
 address-family ipv4
  network 203.0.113.0 mask 255.255.255.0
  neighbor 10.98.14.1 activate
  neighbor 10.98.14.1 route-map RM-ISP-OUT out
 exit-address-family
!
ip prefix-list PL-P seq 5 permit 203.0.113.0/24
ip prefix-list PL-P2 seq 5 permit 192.0.2.0/24
route-map RM-ISP-OUT permit 10
 match ip address prefix-list PL-P
 set metric 20
!
route-map RM-ISP-OUT permit 20
 match ip address prefix-list PL-P2
 set metric 100
!
route-map RM-ISP-OUT permit 30
!
