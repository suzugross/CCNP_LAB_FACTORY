! RT03 (事業者側・変更禁止)
interface Loopback0
 ip address 3.3.3.3 255.255.255.255
!
interface Loopback100
 ip address 203.0.113.3 255.255.255.0
!
interface Loopback101
 ip address 192.0.2.3 255.255.255.0
!
interface {{ links[0] }}
 ip address 10.98.13.3 255.255.255.0
 no shutdown
!
interface {{ links[1] }}
 ip address 10.98.36.3 255.255.255.0
 no shutdown
!
router bgp 64520
 bgp router-id 3.3.3.3
 bgp log-neighbor-changes
 bgp bestpath compare-routerid
 neighbor 10.98.13.1 remote-as 64900
 neighbor 10.98.36.6 remote-as 64900
 address-family ipv4
  network 203.0.113.0 mask 255.255.255.0
  network 192.0.2.0 mask 255.255.255.0
  neighbor 10.98.13.1 activate
  neighbor 10.98.13.1 route-map RM-ISP-OUT out
  neighbor 10.98.36.6 activate
  neighbor 10.98.36.6 route-map RM-ISP-OUT out
 exit-address-family
!
ip prefix-list PL-P seq 5 permit 203.0.113.0/24
ip prefix-list PL-P2 seq 5 permit 192.0.2.0/24
route-map RM-ISP-OUT permit 10
 match ip address prefix-list PL-P
 set metric 140
!
route-map RM-ISP-OUT permit 20
 match ip address prefix-list PL-P2
 set metric 100
!
route-map RM-ISP-OUT permit 30
!
