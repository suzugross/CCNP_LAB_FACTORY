! _POC-MCAST RT04
hostname RT04
ip multicast-routing
interface Loopback0
 ip address 4.4.4.4 255.255.255.255
 ip ospf 1 area 0
 ip pim sparse-mode
!
interface {{ links[0] }}
 ip address 10.0.34.4 255.255.255.0
 ip ospf 1 area 0
 ip ospf network point-to-point
 ip pim sparse-mode
 no shutdown
!
interface {{ links[1] }}
 ip address 10.0.45.4 255.255.255.0
 ip ospf 1 area 0
 ip ospf network point-to-point
 ip pim sparse-mode
 no shutdown
!
interface {{ links[2] }}
 ip address 10.0.100.4 255.255.255.0
 ip ospf 1 area 0
 ip ospf priority 1
 ip pim sparse-mode
 no shutdown
!
router ospf 1
 router-id 4.4.4.4
!
ip pim rp-address 3.3.3.3

