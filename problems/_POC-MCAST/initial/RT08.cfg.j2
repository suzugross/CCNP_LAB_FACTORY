! _POC-MCAST RT08
hostname RT08
ip multicast-routing
interface Loopback0
 ip address 8.8.8.8 255.255.255.255
 ip ospf 1 area 0
 ip pim sparse-mode
!
interface {{ links[0] }}
 ip address 10.0.100.8 255.255.255.0
 ip ospf 1 area 0
 ip ospf priority 1
 ip pim sparse-mode
 no shutdown
!
interface {{ links[1] }}
 ip address 10.0.58.8 255.255.255.0
 ip ospf 1 area 0
 ip ospf network point-to-point
 ip pim sparse-mode
 no shutdown
!
router ospf 1
 router-id 8.8.8.8
!
ip pim rp-address 3.3.3.3

