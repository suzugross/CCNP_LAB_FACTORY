! RT04
interface Loopback0
 ip address 14.14.14.14 255.255.255.255
!
interface Loopback1
 ip address 172.16.60.1 255.255.255.0
!
interface {{ links[1] }}
 ip address 10.223.30.1 255.255.255.252
 no shutdown
!
interface {{ links[0] }}
 ip address 10.72.69.2 255.255.255.252
 no shutdown
!
router bgp 65184
 bgp router-id 14.14.14.14
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
 bgp bestpath compare-routerid
 neighbor 10.223.30.2 remote-as 65030
 neighbor 10.72.69.1 remote-as 64945
 address-family ipv4 unicast
  network 172.16.60.0 mask 255.255.255.0
  neighbor 10.223.30.2 activate
  neighbor 10.72.69.1 activate
  neighbor 10.223.30.2 allowas-in
 exit-address-family
!
