! RT01
interface Loopback0
 ip address 15.15.15.15 255.255.255.255
!
interface Loopback1
 ip address 172.16.71.1 255.255.255.0
!
interface {{ links[0] }}
 ip address 10.253.20.1 255.255.255.252
 no shutdown
!
interface {{ links[1] }}
 ip address 10.223.30.2 255.255.255.252
 no shutdown
!
router bgp 65030
 bgp router-id 15.15.15.15
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
 bgp bestpath compare-routerid
 neighbor 10.253.20.2 remote-as 64667
 neighbor 10.223.30.1 remote-as 65184
 address-family ipv4 unicast
  network 172.16.71.0 mask 255.255.255.0
  neighbor 10.253.20.2 activate
  neighbor 10.223.30.1 activate
 exit-address-family
!
