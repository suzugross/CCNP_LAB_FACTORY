! XRT-12 XE1(Catalyst 8000V 17.15.1a)= PE。学ぶ側が設定する。
! ★8000V は既定のライセンスの段階では MPLS が無い。構築の最後に xe_license.py が保存+再起動する(problem.yml の xe_license_boot)。
license boot level network-advantage addon dna-advantage
!
mpls label protocol ldp
mpls ldp router-id Loopback0 force
!
interface Loopback0
 ip address 10.255.0.41 255.255.255.255
 ip router isis CORE
!
interface {{ links[0] }}
 description CORE to P1
 ip address 10.0.41.41 255.255.255.0
 ip router isis CORE
 isis network point-to-point
 mpls ip
 no shutdown
!
ethernet evc E130
!
! --- お客さま C の拠点 1(CE1)。VPLS(VLAN 210)は前任者の作り・E-Line 130 は据付 ---
interface {{ links[1] }}
 description to CE1 (customer C, site 1)
 no ip address
 no shutdown
 service instance 210 ethernet
  description E-LAN VPLS 210
  encapsulation dot1q 210
  rewrite ingress tag pop 1 symmetric
 !
 service instance 130 ethernet E130
  description E-Line 130 to site 3
  encapsulation dot1q 130
  rewrite ingress tag pop 1 symmetric
 !
!
interface {{ links[2] }}
 description to SW1 (customer C, site 4)
 no ip address
 no shutdown
!
l2vpn vfi context VPLS210
 vpn id 210
 member 10.255.0.42 encapsulation mpls
!
bridge-domain 210
 member {{ links[1] }} service-instance 210
 member vfi VPLS210
!
l2vpn xconnect context E130
 member {{ links[1] }} service-instance 130
 member 10.255.0.43 130 encapsulation mpls
!
router isis CORE
 net 49.0001.0100.0000.0041.00
 is-type level-2-only
 metric-style wide
 log-adjacency-changes
!
