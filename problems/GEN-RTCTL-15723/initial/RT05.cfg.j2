! ============================================================
! RT05 — 基線(IP+基本ルーティング)は構築済み。
! リスト・再配送は未投入(作問仕様)。
! ============================================================
interface Loopback0
 ip address 5.5.5.5 255.255.255.255
interface Ethernet0/0
 description === to RT01 (OSPF) ===
 ip address 10.1.15.2 255.255.255.252
 no shutdown
interface Loopback1
 ip address 10.58.34.1 255.255.255.0
 ip ospf network point-to-point
interface Loopback2
 ip address 10.58.37.1 255.255.255.0
 ip ospf network point-to-point
interface Loopback3
 ip address 10.58.40.1 255.255.255.0
 ip ospf network point-to-point
interface Loopback9
 ip address 172.23.100.1 255.255.255.0
 ip ospf network point-to-point
!
router ospf 53
 router-id 5.5.5.5
 network 10.1.15.0 0.0.0.3 area 0
 network 10.58.34.0 0.0.0.255 area 0
 network 10.58.37.0 0.0.0.255 area 0
 network 10.58.40.0 0.0.0.255 area 0
 network 172.23.100.0 0.0.0.255 area 0
