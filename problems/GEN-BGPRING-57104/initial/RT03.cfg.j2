! RT03
interface Loopback0
 ip address 48.48.48.48 255.255.255.255
!
interface Loopback1
 ip address 172.16.7.1 255.255.255.0
!
interface {{ links[1] }}
 ip address 10.27.178.1 255.255.255.252
 no shutdown
!
interface {{ links[0] }}
 ip address 10.125.127.2 255.255.255.252
 no shutdown
!
router bgp 65346
 bgp router-id 48.48.48.48
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
 bgp bestpath compare-routerid
 neighbor 10.27.178.2 remote-as 64758
 neighbor 10.125.127.1 remote-as 64956
 address-family ipv4 unicast
  network 172.16.7.0 mask 255.255.255.0
  neighbor 10.27.178.2 activate
  neighbor 10.125.127.1 activate
  neighbor 10.27.178.2 route-map RM-MED-OUT out
 exit-address-family
!
route-map RM-MED-OUT permit 10
 set metric 200
!
