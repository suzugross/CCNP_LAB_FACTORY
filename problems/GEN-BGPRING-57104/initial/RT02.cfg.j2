 neighbor 10.125.127.2 remote-as 65346
 neighbor 10.157.180.1 remote-as 64517
 address-family ipv4 unicast
  network 172.16.71.0 mask 255.255.255.0
  neighbor 10.125.127.2 activate
  neighbor 10.157.180.1 activate
 exit-address-family
!
