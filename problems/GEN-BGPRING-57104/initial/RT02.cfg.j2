! RT02
interface Loopback0
 ip address 25.25.25.25 255.255.255.255
!
interface Loopback1
 ip address 172.16.71.1 255.255.255.0
!
interface {{ links[1] }}
 ip address 10.125.127.1 255.255.255.252
 no shutdown
!
interface {{ links[0] }}
 ip address 10.157.180.2 255.255.255.252
 no shutdown
!
router bgp 64956
 bgp router-id 25.25.25.25
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
