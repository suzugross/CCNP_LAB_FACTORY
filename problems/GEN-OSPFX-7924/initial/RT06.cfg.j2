! RT06 (role=a, ospf=network) 初期構成
interface Loopback0
 ip address 73.73.73.73 255.255.255.255
!
interface {{ links[0] }}
 ip address 10.93.116.2 255.255.255.252
 no shutdown
!
interface {{ links[1] }}
 ip address 10.99.78.1 255.255.255.252
 no shutdown
!
router ospf 1
 router-id 73.73.73.73
 network 73.73.73.73 0.0.0.0 area 0
 network 10.93.116.0 0.0.0.3 area 0
 network 10.99.78.0 0.0.0.3 area 0
 distribute-list prefix DL-BLOCK in
!
ip prefix-list DL-BLOCK seq 5 deny 49.49.49.49/32
ip prefix-list DL-BLOCK seq 100 permit 0.0.0.0/0 le 32
!
