! RT02 初期状態 (リレー+セキュリティACL・昨日 強化を実施した直後の状態)
ip access-list extended CAMPUS-DHCP-ONLY
 permit udp any eq bootpc any eq bootps
 permit icmp any any
 deny ip any any
!
interface {{ links[0] }}
 description === to RT01 (DHCP server) ===
 ip address 10.6.116.2 255.255.255.252
 no shutdown
!
interface {{ links[1] }}
 description === CLIENT segment A (CL1) ===
 ip address 10.6.114.1 255.255.255.0
 ip helper-address 10.6.116.1
 ip access-group CAMPUS-DHCP-ONLY in
 no shutdown
!
interface {{ links[2] }}
 description === CLIENT segment B (CL2) ===
 ip address 10.6.115.1 255.255.255.0
 ip helper-address 10.6.116.1
 ip access-group CAMPUS-DHCP-ONLY in
 no shutdown
!
! LOCAL セグメントへの経路 (既設・変更禁止)
ip route 10.6.113.0 255.255.255.0 10.6.116.1
!
