! --- data plane ---
interface Loopback0
 ip address 87.87.87.87 255.255.255.255
interface Ethernet0/0
 description === to RT02 ===
 ip address 10.1.23.2 255.255.255.252
 no shutdown
router ospf 1
 router-id 87.87.87.87
 network 87.87.87.87 0.0.0.0 area 0
 network 10.1.23.0 0.0.0.3 area 0
! --- SNMPv3 (NOC 監視標準) ---
snmp-server view MONVIEW iso included
snmp-server group MONGRP v3 priv read MONVIEW access 99
snmp-server location CCNP-LAB
access-list 99 deny   10.99.0.2
access-list 99 permit any
snmp-server user MONUSER MONGRP v3 auth sha CCNP-Auth-2026 priv aes 128 CCNP-Priv-2026
