! RT01
interface Loopback0
 ip address 73.73.73.73 255.255.255.255
!
interface Loopback1
 ip address 172.16.42.1 255.255.255.0
!
interface {{ links[0] }}
 ip address 10.140.242.1 255.255.255.252
 no shutdown
!
interface {{ links[1] }}
 ip address 10.233.228.2 255.255.255.252
 no shutdown
!
router bgp 65349
 bgp router-id 73.73.73.73
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
 bgp bestpath compare-routerid
 neighbor 10.140.242.2 remote-as 65263
 neighbor 10.233.228.1 remote-as 65263
 address-family ipv4 unicast
  network 172.16.42.0 mask 255.255.255.0
  neighbor 10.140.242.2 activate
  neighbor 10.233.228.1 activate
 exit-address-family
!
route-map RM-MAINT-2019 deny 10
 set metric 100
!
