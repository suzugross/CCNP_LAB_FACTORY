! RT02 (事業者側・変更禁止)
interface Loopback0
 ip address 2.2.2.2 255.255.255.255
!
interface Loopback100
 ip address 100.64.24.2 255.255.255.0
!
interface Loopback101
 ip address 198.51.100.2 255.255.255.0
!
interface {{ links[0] }}
 ip address 10.91.12.2 255.255.255.0
 no shutdown
!
interface {{ links[1] }}
 ip address 10.91.25.2 255.255.255.0
 no shutdown
!
router bgp 64520
 bgp router-id 2.2.2.2
 bgp log-neighbor-changes
 bgp bestpath compare-routerid
 neighbor 10.91.12.1 remote-as 64900
 neighbor 10.91.25.5 remote-as 64900
 address-family ipv4
  network 100.64.24.0 mask 255.255.255.0
  network 198.51.100.0 mask 255.255.255.0
  neighbor 10.91.12.1 activate
  neighbor 10.91.12.1 route-map RM-ISP-OUT out
  neighbor 10.91.25.5 activate
  neighbor 10.91.25.5 route-map RM-ISP-OUT out
 exit-address-family
!
ip prefix-list PL-P seq 5 permit 100.64.24.0/24
ip prefix-list PL-P2 seq 5 permit 198.51.100.0/24
route-map RM-ISP-OUT permit 10
 match ip address prefix-list PL-P
 set metric 60
!
route-map RM-ISP-OUT permit 20
 match ip address prefix-list PL-P2
 set metric 100
!
route-map RM-ISP-OUT permit 30
!
