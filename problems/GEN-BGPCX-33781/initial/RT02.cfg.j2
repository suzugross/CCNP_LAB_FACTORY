! RT02 (role=be, AS=65001) 初期構成
interface Loopback0
 ip address 10.0.29.29 255.255.255.255
 ip ospf 1 area 0
!
interface {{ links[0] }}
 ip address 10.175.175.2 255.255.255.252
 ip ospf 1 area 0
 no shutdown
!
interface {{ links[1] }}
 ip address 10.120.120.1 255.255.255.252
 no shutdown
!
interface {{ links[2] }}
 ip address 10.142.142.1 255.255.255.252
 no shutdown
!
router ospf 1
 router-id 10.0.29.29
!
route-map RM-LP-PRIMARY permit 10
 set local-preference 150
!
router bgp 65001
 bgp router-id 10.0.29.29
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
 neighbor 10.0.36.36 remote-as 65001
 neighbor 10.0.36.36 update-source Loopback0
 neighbor 10.120.120.2 remote-as 65100
 neighbor 10.142.142.2 remote-as 65300
 address-family ipv4 unicast
  neighbor 10.0.36.36 activate
  neighbor 10.0.36.36 send-community
  neighbor 10.0.36.36 next-hop-self
  neighbor 10.120.120.2 activate
  neighbor 10.120.120.2 route-map RM-LP-PRIMARY in
  neighbor 10.142.142.2 activate
  neighbor 10.142.142.2 default-originate
  aggregate-address 172.31.0.0 255.255.252.0 summary-only
 exit-address-family
!
