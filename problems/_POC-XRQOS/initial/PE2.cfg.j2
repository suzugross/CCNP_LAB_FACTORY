! _POC-XRQOS PE2(IOL 17.15)= PE(VRF A の拠点 2・グローバルのお客さま CUST2)。RR1 と iBGP(ipv4・vpnv4)。捨て先 192.0.2.1 → Null0 は据付。
mpls label protocol ldp
mpls ldp router-id Loopback0 force
!
vrf definition A
 rd 10.255.0.2:100
 address-family ipv4
  route-target export 65000:100
  route-target import 65000:100
 exit-address-family
!
interface Loopback0
 ip address 10.255.0.2 255.255.255.255
 ip router isis CORE
!
interface {{ links[0] }}
 description CORE to P1
 ip address 10.0.2.2 255.255.255.0
 ip router isis CORE
 isis network point-to-point
 mpls ip
 no shutdown
!
interface {{ links[1] }}
 description to CE2 (VRF A)
 vrf forwarding A
 ip address 172.16.2.254 255.255.255.0
 no shutdown
!
interface {{ links[2] }}
 description to CUST2 (internet customer)
 ip address 172.20.2.254 255.255.255.0
 no shutdown
!
ip route 192.0.2.1 255.255.255.255 Null0
ip route 198.51.100.128 255.255.255.128 172.20.2.1
!
router isis CORE
 net 49.0001.0100.0000.0002.00
 is-type level-2-only
 metric-style wide
 log-adjacency-changes
!
router bgp 65000
 bgp router-id 10.255.0.2
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
 neighbor 10.255.0.52 remote-as 65000
 neighbor 10.255.0.52 description RR1
 neighbor 10.255.0.52 update-source Loopback0
 !
 address-family ipv4
  network 198.51.100.128 mask 255.255.255.128
  neighbor 10.255.0.52 activate
  neighbor 10.255.0.52 send-community both
  neighbor 10.255.0.52 next-hop-self
 exit-address-family
 !
 address-family vpnv4
  neighbor 10.255.0.52 activate
  neighbor 10.255.0.52 send-community both
 exit-address-family
 !
 address-family ipv4 vrf A
  neighbor 172.16.2.1 remote-as 65002
  neighbor 172.16.2.1 activate
 exit-address-family
!
