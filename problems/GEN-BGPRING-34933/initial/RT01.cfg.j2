! RT01
interface Loopback0
 ip address 76.76.76.76 255.255.255.255
!
interface Loopback1
 ip address 172.16.225.1 255.255.255.0
!
interface {{ links[0] }}
 ip address 10.31.114.1 255.255.255.252
 no shutdown
!
interface {{ links[1] }}
 ip address 10.31.62.2 255.255.255.252
 no shutdown
!
router bgp 64512
 bgp router-id 76.76.76.76
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
 bgp bestpath compare-routerid
 neighbor 10.31.114.2 remote-as 64990
 neighbor 10.31.62.1 remote-as 64981
 address-family ipv4 unicast
  network 172.16.225.0 mask 255.255.255.0
  neighbor 10.31.114.2 activate
  neighbor 10.31.62.1 activate
 exit-address-family
!
