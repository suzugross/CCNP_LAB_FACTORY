! RT01
interface Loopback0
 ip address 40.40.40.40 255.255.255.255
!
interface Loopback1
 ip address 172.16.26.1 255.255.255.0
!
interface {{ links[0] }}
 ip address 10.130.253.1 255.255.255.252
 no shutdown
!
interface {{ links[1] }}
 ip address 10.249.233.2 255.255.255.252
 no shutdown
!
router bgp 65157
 bgp router-id 40.40.40.40
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
 bgp bestpath compare-routerid
 neighbor 10.130.253.2 remote-as 65291
 neighbor 10.249.233.1 remote-as 64951
 bgp always-compare-med
 address-family ipv4 unicast
  network 172.16.26.0 mask 255.255.255.0
  neighbor 10.130.253.2 activate
  neighbor 10.249.233.1 activate
  neighbor 10.130.253.2 route-map RM-PREPEND-OUT out
 exit-address-family
!
ip prefix-list PL-SELF permit 172.16.26.0/24
route-map RM-PREPEND-OUT permit 10
 match ip address prefix-list PL-SELF
 set as-path prepend 65157 65157
route-map RM-PREPEND-OUT permit 20
!
