! RT01 (本社)
interface Loopback1
 ip address 10.64.0.1 255.255.255.0
!
ip access-list extended EDGE-IN
 permit udp any host 203.0.113.2 eq isakmp
 permit udp any host 203.0.113.2 eq non500-isakmp
 permit esp any host 203.0.113.2
 permit icmp any any
 deny   ip any any
!
interface {{ links[0] }}
 description === to ISP ===
 ip address 203.0.113.2 255.255.255.252
 ip access-group EDGE-IN in
 no shutdown
!
ip route 0.0.0.0 0.0.0.0 203.0.113.1
!
crypto isakmp policy 10
 encryption aes 256
 hash sha256
 authentication pre-share
 group 14
!
crypto isakmp key WANKEY9737 address 0.0.0.0
!
crypto ipsec transform-set TS-DMVPN esp-aes 256 esp-sha256-hmac
 mode transport
!
interface Tunnel0
 ip address 172.31.61.1 255.255.255.0
 no ip redirects
 ip mtu 1400
 ip tcp adjust-mss 1360
 ip nhrp authentication SECNET65
 no ip nhrp map multicast dynamic
 ip nhrp redirect
 no ip split-horizon eigrp 549
 tunnel source {{ links[0] }}
 tunnel mode gre multipoint
 tunnel key 5984
!
router eigrp 549
 network 172.31.61.0 0.0.0.255
 network 10.64.0.0 0.0.0.255
!
