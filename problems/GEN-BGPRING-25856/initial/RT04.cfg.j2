! RT04
interface Loopback0
 ip address 1.1.1.1 255.255.255.255
!
interface Loopback1
 ip address 172.16.210.1 255.255.255.0
!
interface {{ links[1] }}
 ip address 10.7.225.1 255.255.255.252
 no shutdown
!
interface {{ links[0] }}
 ip address 10.79.30.2 255.255.255.252
 no shutdown
!
router bgp 64828
 bgp router-id 1.1.1.1
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
 bgp bestpath compare-routerid
 neighbor 10.7.225.2 remote-as 65409
 neighbor 10.79.30.1 remote-as 64802
 address-family ipv4 unicast
  network 172.16.210.0 mask 255.255.255.0
  neighbor 10.7.225.2 activate
  neighbor 10.79.30.1 activate
 exit-address-family
!
