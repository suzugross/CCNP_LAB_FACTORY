! RT01
interface Loopback0
 ip address 83.83.83.83 255.255.255.255
!
interface Loopback1
 ip address 172.16.134.1 255.255.255.0
!
interface {{ links[0] }}
 ip address 10.217.30.1 255.255.255.252
 no shutdown
!
interface {{ links[1] }}
 ip address 10.7.225.2 255.255.255.252
 no shutdown
!
router bgp 65409
 bgp router-id 83.83.83.83
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
 bgp bestpath compare-routerid
 neighbor 10.217.30.2 remote-as 64620
 neighbor 10.7.225.1 remote-as 64828
 address-family ipv4 unicast
  network 172.16.134.0 mask 255.255.255.0
  neighbor 10.217.30.2 activate
  neighbor 10.7.225.1 activate
  neighbor 10.217.30.2 route-map RM-MED-OUT out
 exit-address-family
!
route-map RM-MED-OUT permit 10
 set metric 50
!
