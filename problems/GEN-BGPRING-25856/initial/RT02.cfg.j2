! RT02
interface Loopback0
 ip address 97.97.97.97 255.255.255.255
!
interface Loopback1
 ip address 172.16.100.1 255.255.255.0
!
interface {{ links[1] }}
 ip address 10.247.18.1 255.255.255.252
 no shutdown
!
interface {{ links[0] }}
 ip address 10.217.30.2 255.255.255.252
 no shutdown
!
router bgp 64620
 bgp router-id 97.97.97.97
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
 bgp bestpath compare-routerid
 neighbor 10.247.18.2 remote-as 64802
 neighbor 10.217.30.1 remote-as 65409
 bgp always-compare-med
 address-family ipv4 unicast
  network 172.16.100.0 mask 255.255.255.0
  neighbor 10.247.18.2 activate
  neighbor 10.217.30.1 activate
 exit-address-family
!
