! RT03
interface Loopback0
 ip address 48.48.48.48 255.255.255.255
!
interface Loopback1
 ip address 172.16.41.1 255.255.255.0
!
interface {{ links[1] }}
 ip address 10.79.30.1 255.255.255.252
 no shutdown
!
interface {{ links[0] }}
 ip address 10.247.18.2 255.255.255.252
 no shutdown
!
router bgp 64802
 bgp router-id 48.48.48.48
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
 bgp bestpath compare-routerid
 neighbor 10.79.30.2 remote-as 64828
 neighbor 10.247.18.1 remote-as 64620
 address-family ipv4 unicast
  network 172.16.41.0 mask 255.255.255.0
  neighbor 10.79.30.2 activate
  neighbor 10.247.18.1 activate
  neighbor 10.247.18.1 route-map RM-MED-OUT out
 exit-address-family
!
route-map RM-MED-OUT permit 10
 set metric 200
!
ip prefix-list PL-ARCHIVE seq 5 permit 192.0.2.137/32
!
