! RT03
interface Loopback0
 ip address 13.13.13.13 255.255.255.255
!
interface Loopback1
 ip address 172.16.243.1 255.255.255.0
!
interface {{ links[1] }}
 ip address 10.8.228.1 255.255.255.252
 no shutdown
!
interface {{ links[0] }}
 ip address 10.214.74.2 255.255.255.252
 no shutdown
!
router bgp 65333
 bgp router-id 13.13.13.13
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
 bgp bestpath compare-routerid
 neighbor 10.8.228.2 remote-as 64791
 neighbor 10.214.74.1 remote-as 64966
 address-family ipv4 unicast
  network 172.16.243.0 mask 255.255.255.0
  neighbor 10.8.228.2 activate
  neighbor 10.214.74.1 activate
 exit-address-family
!
