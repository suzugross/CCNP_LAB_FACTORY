! RT01
interface Loopback0
 ip address 19.19.19.19 255.255.255.255
!
interface Loopback1
 ip address 172.16.137.1 255.255.255.0
!
interface {{ links[0] }}
 ip address 10.109.137.1 255.255.255.252
 no shutdown
!
interface {{ links[1] }}
 ip address 10.43.214.2 255.255.255.252
 no shutdown
!
router bgp 64958
 bgp router-id 19.19.19.19
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
 bgp bestpath compare-routerid
 neighbor 10.109.137.2 remote-as 64966
 neighbor 10.43.214.1 remote-as 64791
 address-family ipv4 unicast
  network 172.16.137.0 mask 255.255.255.0
  neighbor 10.109.137.2 activate
  neighbor 10.43.214.1 activate
 exit-address-family
!
ip prefix-list PL-ARCHIVE seq 5 permit 192.0.2.166/32
!
