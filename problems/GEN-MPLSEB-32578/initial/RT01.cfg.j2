! GEN-MPLSEB-32578 初期状態 (RT01 = PE / 変更対象)
vrf definition CUST_A
 rd 65000:100
 address-family ipv4
  route-target export 65000:100
  route-target import 65000:100
 exit-address-family
!
vrf definition CUST_B
 rd 65000:200
 address-family ipv4
  route-target export 65000:200
  route-target import 65000:200
 exit-address-family
!
interface Loopback0
 ip address 3.3.3.3 255.255.255.255
!
interface Loopback9
 description === local mgmt (IGP/LDP 対象外) ===
 ip address 10.255.1.1 255.255.255.255
!
interface {{ links[0] }}
 description === to RT04 (10.178.212.0/30) ===
 ip address 10.178.212.1 255.255.255.252
 mpls ip
 no shutdown
!
interface {{ links[1] }}
 description === to RT07 CUST_A-CE (site1, 192.168.77.0/30) ===
 vrf forwarding CUST_A
 ip address 192.168.77.2 255.255.255.252
 ip tcp adjust-mss 1452
 no shutdown
!
interface {{ links[2] }}
 description === to RT08 CUST_B-CE (site1, 192.168.18.0/30) ===
 vrf forwarding CUST_B
 ip address 192.168.18.2 255.255.255.252
 ip tcp adjust-mss 1452
 no shutdown
!
mpls ldp router-id Loopback0 force
!
router ospf 1
 router-id 3.3.3.3
 network 3.3.3.3 0.0.0.0 area 0
 network 10.178.212.0 0.0.0.3 area 0
!
ip prefix-list PL-CUST-LAN seq 5 permit 172.16.0.0/16 le 24
route-map RM-CE-IN permit 10
 match ip address prefix-list PL-CUST-LAN
!
router bgp 65000
 bgp router-id 3.3.3.3
 no bgp default ipv4-unicast
 neighbor 46.46.46.46 remote-as 65000
 neighbor 46.46.46.46 update-source Loopback0
 neighbor 35.35.35.35 remote-as 65000
 neighbor 35.35.35.35 update-source Loopback0
 address-family vpnv4
  neighbor 46.46.46.46 activate
  neighbor 35.35.35.35 activate
 exit-address-family
 address-family ipv4 vrf CUST_A
  neighbor 192.168.77.1 remote-as 65101
  neighbor 192.168.77.1 activate
  neighbor 192.168.77.1 route-map RM-CE-IN in
 exit-address-family
 address-family ipv4 vrf CUST_B
  neighbor 192.168.18.1 remote-as 65200
  neighbor 192.168.18.1 activate
  neighbor 192.168.18.1 as-override
  neighbor 192.168.18.1 route-map RM-CE-IN in
 exit-address-family
!
