! RT03
interface Loopback0
 ip address 74.74.74.74 255.255.255.255
!
interface Loopback1
 ip address 172.16.143.1 255.255.255.0
!
interface {{ links[1] }}
 ip address 10.227.181.1 255.255.255.252
 no shutdown
!
interface {{ links[0] }}
 ip address 10.250.254.2 255.255.255.252
 no shutdown
!
router bgp 64680
 bgp router-id 74.74.74.74
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
 bgp bestpath compare-routerid
 neighbor 10.227.181.2 remote-as 65386
 neighbor 10.250.254.1 remote-as 65209
 address-family ipv4 unicast
  network 172.16.143.0 mask 255.255.255.0
  neighbor 10.227.181.2 activate
  neighbor 10.250.254.1 activate
 exit-address-family
!
route-map RM-MAINT-2019 deny 10
 set metric 100
!
