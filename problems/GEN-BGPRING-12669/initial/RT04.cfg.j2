! RT04
interface Loopback0
 ip address 87.87.87.87 255.255.255.255
!
interface Loopback1
 ip address 172.16.225.1 255.255.255.0
!
interface {{ links[1] }}
 ip address 10.7.167.1 255.255.255.252
 no shutdown
!
interface {{ links[0] }}
 ip address 10.227.181.2 255.255.255.252
 no shutdown
!
router bgp 65386
 bgp router-id 87.87.87.87
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
 bgp bestpath compare-routerid
 neighbor 10.7.167.2 remote-as 64750
 neighbor 10.227.181.1 remote-as 64680
 address-family ipv4 unicast
  network 172.16.225.0 mask 255.255.255.0
  neighbor 10.7.167.2 activate
  neighbor 10.227.181.1 activate
  neighbor 10.227.181.1 route-map RM-STEER-OUT out
 exit-address-family
!
ip prefix-list PL-STEER permit 172.16.121.0/24
route-map RM-STEER-OUT permit 10
 match ip address prefix-list PL-STEER
 set as-path prepend 65386 65386
!
