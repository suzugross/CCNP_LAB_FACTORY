! RT02
interface Loopback0
 ip address 93.93.93.93 255.255.255.255
!
interface Loopback1
 ip address 172.16.237.1 255.255.255.0
!
interface {{ links[1] }}
 ip address 10.250.254.1 255.255.255.252
 no shutdown
!
interface {{ links[0] }}
 ip address 10.9.50.2 255.255.255.252
 no shutdown
!
router bgp 65209
 bgp router-id 93.93.93.93
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
 bgp bestpath compare-routerid
 neighbor 10.250.254.2 remote-as 64680
 neighbor 10.9.50.1 remote-as 64750
 address-family ipv4 unicast
  network 172.16.237.0 mask 255.255.255.0
  neighbor 10.250.254.2 activate
  neighbor 10.9.50.1 activate
 exit-address-family
!
