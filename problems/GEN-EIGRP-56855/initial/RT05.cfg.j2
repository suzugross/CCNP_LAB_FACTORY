! RT05 (role=g, eigrp=named) 初期構成 (AS 100)
interface Loopback0
 ip address 10.28.28.28 255.255.255.255
!
interface {{ links[0] }}
 ip address 10.144.144.2 255.255.255.252
 no shutdown
!
router eigrp CCNP
 address-family ipv4 unicast autonomous-system 100
  af-interface Loopback0
   passive-interface
  exit-af-interface
  af-interface {{ links[0] }}
   passive-interface
  exit-af-interface
  eigrp router-id 10.28.28.28
  network 10.28.28.28 0.0.0.0
  network 10.144.144.0 0.0.0.3
 exit-address-family
!
