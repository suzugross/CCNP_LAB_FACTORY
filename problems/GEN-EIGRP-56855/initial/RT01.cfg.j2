! RT01 (role=s, eigrp=named) 初期構成 (AS 100)
interface Loopback0
 ip address 10.19.19.19 255.255.255.255
!
interface {{ links[0] }}
 ip address 10.127.127.1 255.255.255.252
 no shutdown
!
interface {{ links[1] }}
 ip address 10.155.155.1 255.255.255.252
 no shutdown
!
router eigrp CCNP
 address-family ipv4 unicast autonomous-system 100
  metric weights 0 2 0 1 0 0
  af-interface Loopback0
   passive-interface
  exit-af-interface
  eigrp router-id 10.19.19.19
  network 10.19.19.19 0.0.0.0
  network 10.127.127.0 0.0.0.3
  network 10.155.155.0 0.0.0.3
 exit-address-family
!
