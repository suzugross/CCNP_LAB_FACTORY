! RT06 (role=a, eigrp=named) 初期構成 (AS 100)
interface Loopback0
 ip address 10.46.46.46 255.255.255.255
!
interface {{ links[0] }}
 ip address 10.127.127.2 255.255.255.252
 no shutdown
!
interface {{ links[1] }}
 ip address 10.170.170.1 255.255.255.252
 no shutdown
!
router eigrp CCNP
 address-family ipv4 unicast autonomous-system 100
  af-interface Loopback0
   passive-interface
  exit-af-interface
  eigrp router-id 10.46.46.46
  network 10.46.46.46 0.0.0.0
  network 10.127.127.0 0.0.0.3
  network 10.170.170.0 0.0.0.3
 exit-address-family
!
