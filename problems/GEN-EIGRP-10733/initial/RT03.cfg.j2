! RT03 (role=e, eigrp=named) 初期構成 (AS 100)
interface Loopback0
 ip address 10.66.66.66 255.255.255.255
!
interface {{ links[0] }}
 ip address 10.179.179.2 255.255.255.252
 no shutdown
!
interface {{ links[1] }}
 ip address 10.103.103.1 255.255.255.252
 no shutdown
!
router eigrp CCNP
 address-family ipv4 unicast autonomous-system 100
  metric weights 0 2 0 1 0 0
  af-interface Loopback0
   passive-interface
  exit-af-interface
  eigrp router-id 10.66.66.66
  network 10.66.66.66 0.0.0.0
  network 10.179.179.0 0.0.0.3
  network 10.103.103.0 0.0.0.3
 exit-address-family
!
