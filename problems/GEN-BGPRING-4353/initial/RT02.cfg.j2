! RT02
interface Loopback0
 ip address 75.75.75.75 255.255.255.255
!
interface Loopback1
 ip address 172.16.190.1 255.255.255.0
!
interface {{ links[1] }}
 ip address 10.180.191.1 255.255.255.252
 no shutdown
!
interface {{ links[0] }}
 ip address 10.68.103.2 255.255.255.252
 no shutdown
!
router bgp 65029
 bgp router-id 75.75.75.75
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
 bgp bestpath compare-routerid
 neighbor 10.180.191.2 remote-as 64653
 neighbor 10.68.103.1 remote-as 65047
 address-family ipv4 unicast
  network 172.16.190.0 mask 255.255.255.0
  neighbor 10.180.191.2 activate
  neighbor 10.68.103.1 activate
 exit-address-family
!
