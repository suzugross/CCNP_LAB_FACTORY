! _POC-XRL3VPN INET(IOL 17.15)= インターネット役(AS 64500)。XR01 のグローバルと eBGP・既定経路と 203.0.113.0/24 を広告。
interface Loopback10
 description INTERNET SERVER
 ip address 203.0.113.10 255.255.255.0
!
interface {{ links[0] }}
 description to SP XR01 (global)
 ip address 192.0.2.2 255.255.255.0
 no shutdown
!
router bgp 64500
 bgp router-id 203.0.113.10
 bgp log-neighbor-changes
 neighbor 192.0.2.1 remote-as 65000
 address-family ipv4
  network 203.0.113.0 mask 255.255.255.0
  neighbor 192.0.2.1 activate
  neighbor 192.0.2.1 default-originate
 exit-address-family
!
