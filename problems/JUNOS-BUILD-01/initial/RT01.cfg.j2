! JUNOS-BUILD-01 initial (RT01 = 据え付け境界ルータ・変更禁止)
!   links[0]=to RT02 / links[1]=to JUN01 via LAN-IX ext-conn
interface Loopback0
 ip address 1.1.1.1 255.255.255.255
!
interface {{ links[0] }}
 description === to RT02 (area 0) ===
 ip address 10.77.12.1 255.255.255.252
 no shutdown
!
interface {{ links[1] }}
 description === to JUN01 via LAN-IX (containerlab boundary) ===
 ip address 10.0.12.2 255.255.255.252
 no shutdown
!
router ospf 1
 router-id 1.1.1.1
 network 0.0.0.0 255.255.255.255 area 0
