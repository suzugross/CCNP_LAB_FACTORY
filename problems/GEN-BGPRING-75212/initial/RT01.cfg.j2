! RT01
interface Loopback0
 ip address 40.40.40.40 255.255.255.255
!
interface Loopback1
 ip address 172.16.70.1 255.255.255.0
!
interface {{ links[0] }}
 ip address 10.31.97.1 255.255.255.252
 no shutdown
!
interface {{ links[1] }}
 ip address 10.63.127.2 255.255.255.252
 no shutdown
!
router bgp 65502
 bgp router-id 40.40.40.40
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
 bgp bestpath compare-routerid
 neighbor 10.31.97.2 remote-as 64713
 neighbor 10.63.127.1 remote-as 65082
 address-family ipv4 unicast
  network 172.16.70.0 mask 255.255.255.0
  neighbor 10.31.97.2 activate
  neighbor 10.63.127.1 activate
  neighbor 10.31.97.2 route-map RM-STEER-OUT out
 exit-address-family
!
ip prefix-list PL-STEER permit 172.16.5.0/24
route-map RM-STEER-OUT permit 10
 match ip address prefix-list PL-STEER
 set as-path prepend 65502 65502
route-map RM-STEER-OUT deny 20
!
