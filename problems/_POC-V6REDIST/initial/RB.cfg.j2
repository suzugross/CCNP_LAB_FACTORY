! _POC-V6REDIST 基線: RB(EIGRP 側の中継)。named mode の IPv6 AF は
! 明示 shutdown しない限り全 IPv6 IF が参加する(network 文は不要)。
ipv6 unicast-routing
ipv6 cef
!
interface Ethernet0/0
 description === to RT-C ===
 no ip address
 ipv6 address 2001:DB8:A:A::2/64
 ipv6 enable
 no shutdown
!
interface Ethernet0/1
 description === to C2 ===
 no ip address
 ipv6 address 2001:DB8:1A:A::1/64
 no shutdown
!
router eigrp NAMED
 !
 address-family ipv6 unicast autonomous-system 5400
  !
  topology base
  exit-af-topology
  eigrp router-id 3.3.3.3
 exit-address-family
!
