! _POC-V6REDIST 基線: RA(OSPFv3 側の中継)。
ipv6 unicast-routing
ipv6 cef
!
interface Ethernet0/0
 description === to RT-C ===
 no ip address
 ipv6 address 2001:DB8:1:1::2/64
 ipv6 enable
 ipv6 ospf 544 area 0
 no shutdown
!
interface Ethernet0/1
 description === to C1 ===
 no ip address
 ipv6 address 2001:DB8:2:1::1/64
 ipv6 enable
 ipv6 ospf 544 area 0
 no shutdown
!
router ospfv3 544
 router-id 4.4.4.4
 !
 address-family ipv6 unicast
 exit-address-family
!
