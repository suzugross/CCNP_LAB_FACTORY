! RT01 (AS 64515 / AS-a edge / BGP=mpbgp)
interface Loopback0
 ip address 12.12.12.12 255.255.255.255
!
interface {{ links[0] }}
 ip address 10.249.162.1 255.255.255.252
 no shutdown
!
router bgp 64515
 bgp router-id 12.12.12.12
 no bgp default ipv4-unicast
