! RT02 (role=s, eigrp=named) 初期構成 (AS 100)
interface Loopback0
 ip address 10.91.91.91 255.255.255.255
!
interface {{ links[0] }}
 ip address 10.101.101.1 255.255.255.252
 no shutdown
!
interface {{ links[1] }}
 ip address 10.171.171.1 255.255.255.252
 no shutdown
!
router eigrp CCNP
 address-family ipv4 unicast autonomous-system 100
  af-interface Loopback0
   passive-interface
  exit-af-interface
  eigrp router-id 10.91.91.91
  network 10.91.91.91 0.0.0.0
  network 10.101.101.0 0.0.0.3
  network 10.171.171.0 0.0.0.3
 exit-address-family
!
