! RT05 初期構成 (相互再配送 RIP⇄OSPF TS・故障注入済)
interface Loopback0
 ip address 66.66.66.66 255.255.255.255
!
interface {{ links[0] }}
 ip address 172.16.41.2 255.255.255.252
 no shutdown
!
interface {{ links[1] }}
 ip address 172.16.61.2 255.255.255.252
 no shutdown
!
router ospf 1
 router-id 66.66.66.66
 network 66.66.66.66 0.0.0.0 area 0
 network 172.16.41.0 0.0.0.3 area 0
 network 172.16.61.0 0.0.0.3 area 0
!
