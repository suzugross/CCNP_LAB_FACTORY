! _POC-XRBGP CE1(IOL 17.15)= AS 65001 の拠点。Loopback1 が送信元の LAN の代わり(IP SLA の送信元)。
no ip domain lookup
!
interface Loopback1
 ip address 192.168.1.1 255.255.255.0
!
interface {{ links[0] }}
 description to PE1
 ip address 172.16.1.1 255.255.255.0
 no shutdown
!
router bgp 65001
 bgp router-id 192.168.1.1
 bgp log-neighbor-changes
 neighbor 172.16.1.254 remote-as 65000
 !
 address-family ipv4
  network 192.168.1.0
  neighbor 172.16.1.254 activate
 exit-address-family
!
