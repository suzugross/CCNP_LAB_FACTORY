! RT01 (AS 65466 / AS-a edge / BGP=mpbgp)
interface Loopback0
 ip address 94.94.94.94 255.255.255.255
!
interface {{ links[0] }}
 ip address 10.110.223.1 255.255.255.252
 no shutdown
!
router bgp 65466
 bgp router-id 94.94.94.94
 no bgp default ipv4-unicast
 neighbor 10.110.223.2 remote-as 65509
 neighbor 10.110.223.2 shutdown
 address-family ipv4 unicast
  neighbor 10.110.223.2 activate
  network 94.94.94.94 mask 255.255.255.255
 exit-address-family
!
