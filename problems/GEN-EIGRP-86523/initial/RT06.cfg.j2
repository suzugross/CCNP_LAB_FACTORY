! RT06 (role=d, eigrp=named) 初期構成 (AS 100)
interface Loopback0
 ip address 10.34.34.34 255.255.255.255
!
interface {{ links[0] }}
 ip address 10.116.116.2 255.255.255.252
 no shutdown
!
interface {{ links[1] }}
 ip address 10.145.145.2 255.255.255.252
 no shutdown
!
interface {{ links[2] }}
 ip address 10.129.129.1 255.255.255.252
 no shutdown
!
router eigrp CCNP
 address-family ipv4 unicast autonomous-system 100
  eigrp stub connected
  af-interface Loopback0
   passive-interface
  exit-af-interface
  eigrp router-id 10.34.34.34
  network 10.34.34.34 0.0.0.0
  network 10.116.116.0 0.0.0.3
  network 10.145.145.0 0.0.0.3
  network 10.129.129.0 0.0.0.3
 exit-address-family
!
