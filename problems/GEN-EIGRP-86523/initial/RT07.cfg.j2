! RT07 (role=g, eigrp=named) 初期構成 (AS 100)
interface Loopback0
 ip address 10.60.60.60 255.255.255.255
!
interface {{ links[0] }}
 ip address 10.194.194.2 255.255.255.252
 no shutdown
!
router eigrp CCNP
 address-family ipv4 unicast autonomous-system 100
  af-interface Loopback0
   passive-interface
  exit-af-interface
  eigrp router-id 10.60.60.60
  network 10.60.60.60 0.0.0.0
  network 10.194.194.0 0.0.0.3
 exit-address-family
!
