! RT03
interface Loopback0
 ip address 2.2.2.2 255.255.255.255
!
interface Loopback1
 ip address 172.16.60.1 255.255.255.0
!
interface {{ links[1] }}
 ip address 10.195.167.1 255.255.255.252
 no shutdown
!
interface {{ links[0] }}
 ip address 10.75.60.2 255.255.255.252
 no shutdown
!
router bgp 65221
 bgp router-id 2.2.2.2
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
 bgp bestpath compare-routerid
 neighbor 10.195.167.2 remote-as 64576
 neighbor 10.75.60.1 remote-as 64635
 address-family ipv4 unicast
  network 172.16.60.0 mask 255.255.255.0
  neighbor 10.195.167.2 activate
  neighbor 10.75.60.1 activate
  neighbor 10.195.167.2 route-map RM-MED-OUT out
 exit-address-family
!
route-map RM-MED-OUT permit 10
 set metric 200
!
