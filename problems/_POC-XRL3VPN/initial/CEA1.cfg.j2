! _POC-XRL3VPN CEA1(IOL 17.15)= お客さまの CE(AS 65101)。
interface Loopback10
 description LAN
 ip address 10.101.1.1 255.255.255.0
!
interface Loopback11
 description PUBLIC (Internet-facing)
 ip address 198.51.100.1 255.255.255.0
!
interface {{ links[0] }}
 description to PE
 ip address 172.16.11.2 255.255.255.0
 no shutdown
!
router bgp 65101
 bgp router-id 10.101.1.1
 bgp log-neighbor-changes
 neighbor 172.16.11.1 remote-as 65000
 address-family ipv4
  network 10.101.1.0 mask 255.255.255.0
  network 198.51.100.0 mask 255.255.255.0
  neighbor 172.16.11.1 activate
 exit-address-family
!
