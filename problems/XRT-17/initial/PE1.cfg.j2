!! XRT-17 PE1(XRv9000 26.1.1)= 入口の PE(CE1 から T への道の入口)。PIC の切り替えを通信で測るため XRv9000(design §32.3 #10)。
interface Loopback0
 ipv4 address 10.255.0.1 255.255.255.255
!
interface {{ links[3] }}
 description to P1
 ipv4 address 10.0.1.1 255.255.255.0
 no shutdown
!
interface {{ links[4] }}
 description to CE1 (AS 65001)
 ipv4 address 172.16.1.254 255.255.255.0
 no shutdown
!
router isis CORE
 is-type level-2-only
 net 49.0001.0100.0000.0001.00
 log adjacency changes
 address-family ipv4 unicast
  metric-style wide
 !
 interface Loopback0
  passive
  address-family ipv4 unicast
  !
 !
 interface {{ links[3] }}
  point-to-point
  address-family ipv4 unicast
  !
 !
!
mpls ldp
 router-id 10.255.0.1
 interface {{ links[3] }}
 !
!
route-policy PASS
  pass
end-policy
!
router bgp 65000
 bgp router-id 10.255.0.1
 address-family ipv4 unicast
 !
 neighbor 10.255.0.21
  remote-as 65000
  description RR1
  update-source Loopback0
  address-family ipv4 unicast
   next-hop-self
  !
 !
 neighbor 172.16.1.1
  remote-as 65001
  address-family ipv4 unicast
   route-policy PASS in
   route-policy PASS out
  !
 !
!
