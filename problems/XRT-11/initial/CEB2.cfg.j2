! XRT-11 CEB2(IOL 17.15・据付・変更しない)= お客さまの CE(AS 65202)。
interface Loopback10
 description LAN
 ip address 10.102.2.1 255.255.255.0
!

interface {{ links[0] }}
 description to PE
 ip address 172.16.22.2 255.255.255.0
 no shutdown
!
router bgp 65202
 bgp router-id 10.102.2.1
 bgp log-neighbor-changes
 neighbor 172.16.22.1 remote-as 65000
 address-family ipv4
  network 10.102.2.0 mask 255.255.255.0

  neighbor 172.16.22.1 activate
 exit-address-family
!
! M11= E-Line(L2)のサブインタフェース
interface {{ links[0] }}.300
 description E-Line 300 to site 1
 encapsulation dot1Q 300
 ip address 172.31.30.2 255.255.255.0
!
interface {{ links[0] }}.310
 description E-Line 310 to site 1
 encapsulation dot1Q 310
 ip address 172.31.31.2 255.255.255.0
!
