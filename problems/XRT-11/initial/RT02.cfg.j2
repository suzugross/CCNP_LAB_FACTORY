! XRT-11 RT02(IOL 17.15・据付・変更しない)= XRT-10 と同じ PE(お客さま A/B の VRF・VPNv4 は XR02 とだけ・CEA2 とは as-override)に SR の準備を足したもの。
! SR= SRGB 既定・Lo0 の index 12・SR 優先・TI-LFA・Flex-Algo 128 に参加(定義は持たない・index 1xx= 読み物の「やってみる」用)。IOS どうしの LDP は残す。
mpls label protocol ldp
mpls ldp router-id Loopback0 force
mpls ldp neighbor 10.255.0.13 password CoreLdp-2026
!
vrf definition CUST-A
 rd 10.255.0.12:101
 address-family ipv4
  route-target export 65000:101
  route-target import 65000:101
  route-target import 65000:900
 exit-address-family
!
vrf definition CUST-B
 rd 10.255.0.12:102
 address-family ipv4
  route-target export 65000:102
  route-target import 65000:102
  route-target import 65000:900
 exit-address-family
!
segment-routing mpls
 !
 set-attributes
  address-family ipv4
   sr-label-preferred
  exit-address-family
 !
 connected-prefix-sid-map
  address-family ipv4
   10.255.0.12/32 index 12 range 1
  exit-address-family
 !
  address-family ipv4 algorithm 128
   10.255.0.12/32 index 112 range 1
  exit-address-family
!
interface Loopback0
 ip address 10.255.0.12 255.255.255.255
 ip router isis CORE
!
interface {{ links[0] }}
 description CORE-A to RT01
 ip address 10.0.12.12 255.255.255.0
 ip router isis CORE
 isis network point-to-point
 isis metric 10
 mpls ip
 no shutdown
!
interface {{ links[1] }}
 description CORE-B to RT03
 ip address 10.0.23.12 255.255.255.0
 ip router isis CORE
 isis network point-to-point
 isis metric 100
 mpls ip
 no shutdown
!
interface {{ links[2] }}
 description CUST-A site 2 (CEA2)
 vrf forwarding CUST-A
 ip address 172.16.12.1 255.255.255.0
 no shutdown
!
interface {{ links[4] }}
 description CUST-B site 2 (CEB2)
 vrf forwarding CUST-B
 ip address 172.16.22.1 255.255.255.0
 no shutdown
!
! M11= お客さま A/B の E-Line の拠点 2 側(据付)。L3VPN のポートにサブインタフェースを足し、XR01 と LDP の疑似回線(xconnect)でつなぐ。
! A= VLAN 200 ⇔ XR01 の VLAN 100(pw-id 100・M11-1)/B= VLAN 300・310 ⇔ XR01 の 300・310(pw-id 300・310・M11-2)。
interface {{ links[2] }}.200
 description CUST-A E-Line to site 1 (pw-id 100)
 encapsulation dot1Q 200
 xconnect 10.255.0.1 100 encapsulation mpls
!
interface {{ links[4] }}.300
 description CUST-B E-Line 300 to site 1 (pw-id 300)
 encapsulation dot1Q 300
 xconnect 10.255.0.1 300 encapsulation mpls
!
interface {{ links[4] }}.310
 description CUST-B E-Line 310 to site 1 (pw-id 310)
 encapsulation dot1Q 310
 xconnect 10.255.0.1 310 encapsulation mpls
!
router isis CORE
 net 49.0001.0100.0000.0012.00
 is-type level-2-only
 metric-style wide
 segment-routing mpls
 fast-reroute per-prefix level-2 all
 fast-reroute ti-lfa level-2
 flex-algo 128
 log-adjacency-changes
 mpls ldp sync
!
router bgp 65000
 bgp router-id 10.255.0.12
 bgp log-neighbor-changes
 neighbor 10.255.0.21 remote-as 65000
 neighbor 10.255.0.21 description VPNv4 RR XR02
 neighbor 10.255.0.21 update-source Loopback0
 address-family ipv4
  no neighbor 10.255.0.21 activate
 exit-address-family
 address-family vpnv4
  neighbor 10.255.0.21 activate
  neighbor 10.255.0.21 send-community extended
 exit-address-family
 address-family ipv4 vrf CUST-A
  neighbor 172.16.12.2 remote-as 65101
  neighbor 172.16.12.2 activate
  neighbor 172.16.12.2 as-override
 exit-address-family
 address-family ipv4 vrf CUST-B
  neighbor 172.16.22.2 remote-as 65202
  neighbor 172.16.22.2 activate
 exit-address-family
!
