interface {{ links[2] }}
 description === to RT10 CUST_B-CE (site2, 192.168.30.0/30) ===
 vrf forwarding CUST_B
 ip address 192.168.30.2 255.255.255.252
 ip tcp adjust-mss 1452
 no shutdown
