 address-family ipv4 vrf CUST_B
  neighbor 192.168.30.1 remote-as 65200
  neighbor 192.168.30.1 activate
  neighbor 192.168.30.1 as-override
  neighbor 192.168.30.1 route-map RM-CE-IN in
