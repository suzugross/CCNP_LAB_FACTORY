 address-family ipv4
  route-target export 65000:100
  route-target import 65000:100
 exit-address-family
!
vrf definition CUST_B
 rd 65000:200
 address-family ipv4
  route-target export 65000:200
  route-target import 65000:200
 exit-address-family
!
interface Loopback0
 ip address 65.65.65.65 255.255.255.255
!
interface Loopback9
 description === local mgmt (IGP/LDP 対象外) ===
 ip address 10.255.2.1 255.255.255.255
!
interface {{ links[0] }}
 description === to RT05 (10.192.167.0/30) ===
 ip address 10.192.167.1 255.255.255.252
 mpls ip
 no shutdown
!
interface {{ links[1] }}
 description === to RT09 CUST_A-CE (site2, 192.168.222.0/30) ===
