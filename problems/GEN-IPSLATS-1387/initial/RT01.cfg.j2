! RT01 初期状態 (顧客エッジ・先般 監視の導入/変更作業を実施した直後の状態)
ip access-list extended SEC-PROTECT-IN
 deny icmp host 100.64.48.140 host 10.216.19.1 echo-reply
 permit ip any any
!
interface {{ links[0] }}
 description === to RT02 (backup ISP access) ===
 ip address 10.216.163.1 255.255.255.252
 no shutdown
!
interface {{ links[1] }}
 description === to RT03 (primary ISP access) ===
 ip address 10.216.19.1 255.255.255.252
 ip access-group SEC-PROTECT-IN in
 no shutdown
!
interface Loopback0
 ip address 4.4.4.4 255.255.255.255
!
ip sla 83
 icmp-echo 100.64.48.140 source-ip 10.216.19.1
 frequency 10
!
ip sla schedule 83 life forever start-time now
!
track 59 ip sla 83 reachability
!
ip route 100.64.48.140 255.255.255.255 10.216.19.2
ip route 0.0.0.0 0.0.0.0 10.216.19.2 track 59
ip route 0.0.0.0 0.0.0.0 10.216.163.2 250
!
