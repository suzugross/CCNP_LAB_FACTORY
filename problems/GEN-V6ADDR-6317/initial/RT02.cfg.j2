! RT02 初期状態 (デフォルトゲートウェイ / DHCPv6 リレー)
ipv6 unicast-routing
ipv6 cef
!
interface {{ links[0] }}
 description === to RT01 (core) ===
 ipv6 address 2001:DB8:d3:12::2/64
 no shutdown
!
interface {{ links[1] }}
 description === LAN-A (純 stateful DHCPv6（M フラグ・自動生成アドレス禁止）) ===
 ipv6 address 2001:DB8:d3:A::1/64
 no shutdown
 ipv6 dhcp relay destination 2001:DB8:d3:12::1
 ipv6 nd managed-config-flag
 ipv6 nd prefix 2001:DB8:d3:A::/64 2592000 604800 no-autoconfig
!
interface {{ links[2] }}
 description === LAN-B (SLAAC + stateless DHCPv6（O フラグ）) ===
 ipv6 address 2001:DB8:d3:B::1/64
 no shutdown
 ipv6 dhcp relay destination 2001:DB8:d3:12::1
 ipv6 nd other-config-flag
!
ipv6 route 2001:DB8:d3:1::/64 2001:DB8:d3:12::1
!
line vty 0 4
 transport input ssh telnet
!
