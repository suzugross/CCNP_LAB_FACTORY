! RT04 (role=b, eigrp=named) 初期構成 (AS 100)
interface Loopback0
 ip address 10.53.53.53 255.255.255.255
!
interface {{ links[0] }}
 ip address 10.176.176.2 255.255.255.252
 no shutdown
!
interface {{ links[1] }}
 ip address 10.146.146.1 255.255.255.252
 no shutdown
!
router eigrp CCNP
 address-family ipv4 unicast autonomous-system 100
  af-interface Loopback0
   passive-interface
  exit-af-interface
  eigrp router-id 10.53.53.53
  network 10.53.53.53 0.0.0.0
  network 10.176.176.0 0.0.0.3
  network 10.146.146.0 0.0.0.3
 exit-address-family
!
