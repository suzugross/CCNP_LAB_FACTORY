! RT06 (role=d, eigrp=named) 初期構成 (AS 100)
interface Loopback0
 ip address 10.30.30.30 255.255.255.255
!
interface {{ links[0] }}
 ip address 10.141.141.2 255.255.255.252
 no shutdown
!
interface {{ links[1] }}
 ip address 10.146.146.2 255.255.255.252
 no shutdown
!
interface {{ links[2] }}
 ip address 10.155.155.1 255.255.255.252
 shutdown
!
router eigrp CCNP
 address-family ipv4 unicast autonomous-system 100
  af-interface Loopback0
   passive-interface
  exit-af-interface
  eigrp router-id 10.30.30.30
  network 10.30.30.30 0.0.0.0
  network 10.141.141.0 0.0.0.3
  network 10.146.146.0 0.0.0.3
  network 10.155.155.0 0.0.0.3
 exit-address-family
!
