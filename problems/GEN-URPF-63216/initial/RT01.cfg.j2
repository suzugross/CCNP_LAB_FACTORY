! RT01 初期構成 (uRPF TS・昨日 anti-spoofing を導入した直後の状態)
interface Loopback0
 ip address 58.58.58.58 255.255.255.255
!
access-list 99 permit 192.168.149.0 0.0.0.255
!
interface {{ links[0] }}
 description === Uplink-A: to ISP (RT02) ===
 ip address 10.24.164.1 255.255.255.252
 ip verify unicast source reachable-via rx 99
 no shutdown
!
interface {{ links[1] }}
 description === Uplink-B: to ISP (RT03) ===
 ip address 10.108.158.1 255.255.255.252
 ip verify unicast source reachable-via rx
 no shutdown
!
router ospf 1
 router-id 58.58.58.58
 network 58.58.58.58 0.0.0.0 area 0
 network 10.24.164.0 0.0.0.3 area 0
 network 10.108.158.0 0.0.0.3 area 0
!
