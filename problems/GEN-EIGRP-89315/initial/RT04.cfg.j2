! RT04 (role=d, eigrp=named) 初期構成 (AS 100)
interface Loopback0
 ip address 10.33.33.33 255.255.255.255
!
interface {{ links[0] }}
 ip address 10.181.181.2 255.255.255.252
 no shutdown
!
interface {{ links[1] }}
 ip address 10.125.125.2 255.255.255.252
 no shutdown
!
interface {{ links[2] }}
 ip address 10.149.149.1 255.255.255.252
 no shutdown
!
router eigrp CCNP
 address-family ipv4 unicast autonomous-system 100
  af-interface Loopback0
   passive-interface
  exit-af-interface
  eigrp router-id 10.33.33.33
  network 10.33.33.33 0.0.0.0
  network 10.181.181.0 0.0.0.3
  network 10.125.125.0 0.0.0.3
  network 10.149.149.0 0.0.0.3
 exit-address-family
!
