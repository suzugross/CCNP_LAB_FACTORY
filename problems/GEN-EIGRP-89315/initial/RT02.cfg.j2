! RT02 (role=s, eigrp=named) 初期構成 (AS 100)
interface Loopback0
 ip address 10.47.47.47 255.255.255.255
!
interface {{ links[0] }}
 ip address 10.196.196.1 255.255.255.252
 no shutdown
!
interface {{ links[1] }}
 ip address 10.165.165.1 255.255.255.252
 no shutdown
!
router eigrp CCNP
 address-family ipv4 unicast autonomous-system 100
  af-interface Loopback0
   passive-interface
  exit-af-interface
  eigrp router-id 10.47.47.47
  network 10.47.47.47 0.0.0.0
  network 10.196.196.0 0.0.0.3
  network 10.165.165.0 0.0.0.3
 exit-address-family
!
