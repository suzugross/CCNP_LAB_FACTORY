# ローカル環境設定（CML接続情報・管理IPプールなど各自の環境依存値）
# 雛形は group_vars/all/local.yml.example（コミット対象）。
group_vars/all/local.yml

# 設計メモ（非公開・ローカル保持）
DESIGN.md

# Python 仮想環境（巨大・再作成可能）
.venv/

# Python キャッシュ
__pycache__/
*.pyc
*.pyo

# Ansible が build_topology で再生成する成果物（再生成可能）
topologies/_generated/

# MGMT IP リース台帳（ランタイム状態。消えても mgmt_alloc.py gc で CML から復元可）
topologies/_state/

# 採点時の一時ファイル
grade_input.json
*.retry

# エディタ/OS の一時物
*.swp
*~
.DS_Store

# ラボ運用: ラボ作業フォルダ(provisionで生成/teardownで削除・使い捨て)
/lab/

# 机上4択問題(BL-080)の使い捨て展開パック(gen_paper_mcq.py が生成→撤収時に削除。
# 失敗時の残骸をコミットしないための保険)
problems/PAPER-RD-*/

# 問題パック(BL-099): 連続出題の使い捨て成果物(HTML問題用紙・解答用紙・BUILD.log)。
# ユーザが解くための作業領域であって、リポジトリの資産ではない。
/packs/

# 同梱用 mermaid(3.5MB・再取得可)。render_html.py が HTML に埋め込む。
# 取得: curl -sL -o topologies/assets/mermaid.min.js \
#         https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js
topologies/assets/mermaid.min.js

# 非公開（PVT）コンテンツ — 公開リポに含めない。
# 運用ルールは CLAUDE.md「非公開（PVT）コンテンツの取り扱い」参照。
problems/PVT-*/
topologies/pvt_*
private/
